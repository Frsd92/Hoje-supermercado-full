generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String                  @id @default(cuid())
  email         String                  @unique
  name          String?
  image         String?
  favorites     Favorite[]
  orders        Order[]
  notifications NotificationRecipient[]
  createdAt     DateTime                @default(now())
  updatedAt     DateTime                @updatedAt
}

model CustomerProfile {
  email         String    @id
  fullName      String?
  whatsapp      String    @default("")
  cpf           String    @default("")
  gender        String    @default("")
  birthDate     DateTime? @db.Date
  photo         String?   @db.Text
  monthlyBudget Decimal   @default(0) @db.Decimal(12, 2)
  pagarmeCustomerId String? @unique
  pagarmeCardId String? @unique
  pagarmeCardBrand String?
  pagarmeCardLastFourDigits String?
  pagarmeCardExpMonth Int?
  pagarmeCardExpYear Int?
  memberSince   DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model CustomerAddressBook {
  email     String   @id
  addresses Json     @default("[]")
  updatedAt DateTime @updatedAt
}

model ServiceRegionState {
  uf             String                      @id
  name           String
  enabled        Boolean                     @default(false)
  municipalities ServiceRegionMunicipality[]
  createdAt      DateTime                    @default(now())
  updatedAt      DateTime                    @updatedAt
}

model ServiceRegionMunicipality {
  id        String             @id @default(cuid())
  name      String
  stateUf   String
  enabled   Boolean            @default(false)
  state     ServiceRegionState @relation(fields: [stateUf], references: [uf], onDelete: Cascade)
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  @@unique([stateUf, name])
  @@index([stateUf, enabled])
}

model StorePresenceSession {
  id         String   @id
  firstSeenAt DateTime @default(now())
  lastSeenAt  DateTime @default(now())

  @@index([lastSeenAt])
}

model StoreTrafficSnapshot {
  minute         DateTime @id
  onlineVisitors Int
  sampledAt      DateTime @default(now()) @updatedAt
}

model CustomerCart {
  email     String   @id
  items     Json     @default("[]")
  updatedAt DateTime @updatedAt
}

model GuestCart {
  id        String   @id
  items     Json     @default("[]")
  updatedAt DateTime @updatedAt
}

model Product {
  id                 String              @id @default(cuid())
  externalId         String?             @unique
  identityTitle      String?             @unique
  identitySku        String?             @unique
  identityBarcode    String?             @unique
  title              String
  description        String              @default("")
  price              Decimal             @db.Decimal(12, 2)
  cost               Decimal             @db.Decimal(12, 2)
  discount           Decimal             @default(0) @db.Decimal(5, 2)
  quantity           Decimal             @default(0) @db.Decimal(12, 3)
  sku                String?
  barcode            String?
  brand              String?
  supplier           String?
  subcategory        String?
  image              String?
  status             String              @default("Ativo")
  expiry             DateTime?
  categories         String[]
  metadata           Json                @default("{}")
  createdBy          String?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  favorites          Favorite[]
  inventoryLots      ProductLot[]
  orderItems         OrderItem[]
  productBarcodes    ProductBarcode[]
  purchaseOrderItems PurchaseOrderItem[]
}

model ProductLot {
  id               String                   @id @default(cuid())
  productId        String
  identityKey      String                   @unique
  lotCode          String?
  quantity         Decimal                  @default(0) @db.Decimal(12, 3)
  expiry           DateTime?                @db.Date
  manufactureDate  DateTime?                @db.Date
  shelfLifeDays    Int?
  location         String?
  source           String                   @default("MANUAL")
  sourceReference  String?
  createdBy        String?
  createdAt        DateTime                 @default(now())
  updatedAt        DateTime                 @updatedAt
  product          Product                  @relation(fields: [productId], references: [id], onDelete: Restrict)
  orderAllocations InventoryLotAllocation[]

  @@index([productId, expiry])
  @@index([productId, quantity])
}

model InventoryOrderFulfillment {
  orderId     String                   @id
  actor       String
  createdAt   DateTime                 @default(now())
  allocations InventoryLotAllocation[]

  @@index([createdAt])
}

model InventoryLotAllocation {
  id             String                    @id @default(cuid())
  orderId        String
  orderItemIndex Int
  lotId          String
  productId      String
  productTitle   String
  lotCode        String?
  quantity       Decimal                   @db.Decimal(12, 3)
  createdAt      DateTime                  @default(now())
  fulfillment    InventoryOrderFulfillment @relation(fields: [orderId], references: [orderId], onDelete: Cascade)
  lot            ProductLot                @relation(fields: [lotId], references: [id], onDelete: Restrict)

  @@unique([orderId, orderItemIndex, lotId])
  @@index([orderId])
  @@index([lotId])
}

model ProductBarcode {
  id        String  @id @default(cuid())
  productId String
  code      String  @unique
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

model ProductAuditLog {
  id                String   @id @default(cuid())
  productId         String
  productExternalId String?
  productTitle      String
  action            String
  actor             String
  occurredAt        DateTime @default(now())
  snapshot          Json?
  changes           Json?
  note              String?

  @@index([productId, occurredAt])
  @@index([productExternalId, occurredAt])
}

model StoreLayoutAsset {
  key          String   @id
  imageData    String   @db.Text
  contentType  String
  originalName String
  updatedBy    String
  updatedAt    DateTime @updatedAt
}

model Supplier {
  id                String             @id @default(cuid())
  identityName      String             @unique
  identityTaxId     String?            @unique
  name              String
  legalName         String?
  taxId             String?
  email             String?
  phone             String?
  whatsapp          String?
  categories        String[]           @default([])
  status            String             @default("Em Análise")
  statusReason      String?
  contactName       String?
  contactRole       String?
  contactEmail      String?
  contactPhone      String?
  financeContact    String?
  financeEmail      String?
  financePhone      String?
  address           String?
  city              String?
  state             String?
  postalCode        String?
  paymentTerms      String?
  minimumOrderValue Decimal?           @db.Decimal(12, 2)
  deliveryTerms     String?
  createdBy         String
  updatedBy         String?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  auditLogs         SupplierAuditLog[]
  purchaseOrders    PurchaseOrder[]

  @@index([status, name])
}

model SupplierAuditLog {
  id         String   @id @default(cuid())
  supplierId String
  action     String
  actor      String
  occurredAt DateTime @default(now())
  snapshot   Json?
  changes    Json?
  note       String?
  supplier   Supplier @relation(fields: [supplierId], references: [id], onDelete: Restrict)

  @@index([supplierId, occurredAt])
}

model PurchaseOrder {
  id               String                  @id @default(cuid())
  code             String                  @unique
  supplierId       String
  status           String                  @default("Rascunho")
  orderedAt        DateTime                @default(now())
  expectedDelivery DateTime?
  receivedAt       DateTime?
  notes            String?
  total            Decimal                 @db.Decimal(14, 2)
  createdBy        String
  updatedBy        String?
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt
  supplier         Supplier                @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  items            PurchaseOrderItem[]
  auditLogs        PurchaseOrderAuditLog[]

  @@index([status, expectedDelivery])
  @@index([orderedAt])
  @@index([supplierId, orderedAt])
}

model PurchaseOrderItem {
  id               String        @id @default(cuid())
  purchaseOrderId  String
  productId        String
  quantity         Decimal       @db.Decimal(12, 3)
  unitPrice        Decimal       @db.Decimal(12, 2)
  receivedQuantity Decimal       @default(0) @db.Decimal(12, 3)
  receivedUnitCost Decimal?      @db.Decimal(12, 2)
  purchaseOrder    PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  product          Product       @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@unique([purchaseOrderId, productId])
  @@index([productId])
}

model PurchaseOrderAuditLog {
  id              String        @id @default(cuid())
  purchaseOrderId String
  action          String
  actor           String
  occurredAt      DateTime      @default(now())
  snapshot        Json?
  changes         Json?
  note            String?
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Restrict)

  @@index([purchaseOrderId, occurredAt])
}

model Favorite {
  id        String   @id @default(cuid())
  userId    String
  productId String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
}

model Order {
  id                    String               @id
  userId                String?
  customerName          String?
  customerEmail         String?
  address               String
  addressDetails        Json?
  total                 String
  subtotal              Decimal              @default(0) @db.Decimal(12, 2)
  paymentMethod         String               @default("nao_informado")
  paymentStatus         String               @default("manual")
  checkoutRequestId     String?              @unique
  pagarmeOrderId        String?              @unique
  pagarmeChargeId       String?              @unique
  paymentDetails        Json?
  refundedAmount        Decimal              @default(0) @db.Decimal(12, 2)
  includeCpfOnReceipt   Boolean              @default(false)
  invoiceCpf            String?
  couponCode            String?
  couponDiscountPercent Int?
  couponDiscountAmount  Decimal              @default(0) @db.Decimal(12, 2)
  status                String               @default("Recebido")
  updatedBy             String?
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt
  user                  User?                @relation(fields: [userId], references: [id], onDelete: SetNull)
  items                 OrderItem[]
  refundRequests        OrderRefundRequest[]
  serviceRequests       OrderServiceRequest[]
  paymentEvents         PagarmeWebhookEvent[]

  @@index([createdAt])
  @@index([customerEmail])
  @@index([status])
}

model PagarmeWebhookEvent {
  id          String   @id
  eventType   String
  orderId     String?
  receivedAt  DateTime @default(now())
  order       Order?   @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@index([orderId, receivedAt])
  @@index([eventType, receivedAt])
}

model OrderItem {
  id                String   @id @default(cuid())
  orderId           String
  productId         String?
  name              String
  productCode       String?
  price             String
  quantity          Decimal  @default(1) @db.Decimal(12, 3)
  unit              String   @default("unidade")
  unitCost          Decimal? @db.Decimal(12, 2)
  promotionType     String?
  promotionDiscount Decimal  @default(0) @db.Decimal(12, 2)
  order             Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product           Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  serviceRequests   OrderServiceRequest[]

  @@index([productId])
}

model OrderRefundRequest {
  id           String             @id
  code         String             @unique
  orderId      String
  amount       Decimal            @db.Decimal(12, 2)
  reason       String             @db.Text
  status       String             @default("requested")
  requestedBy  String
  reviewedBy   String?
  reviewedAt   DateTime?
  decisionNote String?            @db.Text
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  order        Order              @relation(fields: [orderId], references: [id], onDelete: Restrict)
  events       OrderRefundEvent[]

  @@index([orderId, createdAt])
  @@index([status, createdAt])
}

model OrderRefundEvent {
  id              String             @id
  refundRequestId String
  action          String
  actor           String
  note            String?            @db.Text
  createdAt       DateTime           @default(now())
  refundRequest   OrderRefundRequest @relation(fields: [refundRequestId], references: [id], onDelete: Cascade)

  @@index([refundRequestId, createdAt])
}

model OrderServiceRequest {
  id                 String    @id
  code               String    @unique
  orderId            String
  type               String
  reason             String    @db.Text
  orderItemId        String?
  orderItemName      String?
  replacementProduct String?
  status             String    @default("requested")
  requestedBy        String
  reviewedBy         String?
  reviewedAt         DateTime?
  decisionNote       String?   @db.Text
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  order              Order     @relation(fields: [orderId], references: [id], onDelete: Restrict)
  orderItem          OrderItem? @relation(fields: [orderItemId], references: [id], onDelete: SetNull)

  @@index([orderId, createdAt])
  @@index([status, createdAt])
  @@index([orderItemId])
}

model Notification {
  id           String                  @id
  title        String
  message      String
  audience     String                  @default("all")
  type         String                  @default("promotion")
  durationDays Int
  expiresAt    DateTime
  createdBy    String
  createdAt    DateTime                @default(now())
  recipients   NotificationRecipient[]
}

model CustomerAnnouncement {
  id           String   @id
  title        String
  message      String
  audience     String   @default("all")
  recipients   String[] @default([])
  type         String   @default("promotion")
  durationDays Int
  expiresAt    DateTime
  createdBy    String
  createdAt    DateTime @default(now())

  @@index([expiresAt])
  @@index([createdAt])
}

model NotificationRecipient {
  id             String       @id @default(cuid())
  notificationId String
  userId         String
  notification   Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([notificationId, userId])
}

model CouponCampaign {
  id              String             @id
  code            String             @unique
  discountPercent Int
  message         String             @default("")
  expiresAt       DateTime
  createdBy       String
  createdAt       DateTime           @default(now())
  recipients      CouponRecipient[]
  redemptions     CouponRedemption[]
}

model CouponRecipient {
  id         String         @id @default(cuid())
  campaignId String
  email      String
  campaign   CouponCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@unique([campaignId, email])
  @@index([email])
}

model CouponRedemption {
  id         String         @id @default(cuid())
  campaignId String
  email      String
  orderId    String         @unique
  createdAt  DateTime       @default(now())
  campaign   CouponCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@unique([campaignId, email])
  @@index([email])
}
