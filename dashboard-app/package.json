{
  "name": "hoje-supermercado-dashboard",
  "private": true,
  "scripts": {
    "dev": "node scripts/dev-server.mjs",
    "dev:next": "next dev --hostname 0.0.0.0 --port 3003",
    "build": "node scripts/prepare-store.mjs && next build",
    "start": "next start --hostname 0.0.0.0 --port 3003",
    "start:stable": "npm run build && npm run start",
    "lint": "next lint",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev --name init",
    "db:seed-json": "node scripts/migrate-json-to-postgres.js",
    "catalog:import-xlsx": "node scripts/import-products-xlsx.mjs"
  },
  "dependencies": {
    "@prisma/client": "7.10.0",
    "lucide-react": "^0.468.0",
    "next": "14.2.15",
    "next-auth": "^4.24.7",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "prisma": "7.10.0"
  }
}
